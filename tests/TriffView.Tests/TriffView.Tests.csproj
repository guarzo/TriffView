<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TriffView.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Link the pure logic files directly. NOT a ProjectReference: TriffView.csproj is
       net8.0-windows with UseWPF, and these types are internal. These files depend only on
       System.Drawing.Primitives, which is cross-platform, so they build and test on net8.0. -->
  <ItemGroup>
    <Compile Include="..\..\native\TriffView\PreviewPointerGesture.cs" Link="PreviewPointerGesture.cs" />
    <Compile Include="..\..\native\TriffView\TriffViewRect.cs" Link="TriffViewRect.cs" />
  </ItemGroup>

  <!-- Same arrangement for the combat log export. CombatLogExport needs TriffAlertEvent, which
       lives in TriffAlertsService.cs; both files are plain BCL (IO, compression, regex, JSON)
       with no WPF or Forms dependency, so they build on net8.0 like the files above. -->
  <ItemGroup>
    <Compile Include="..\..\native\TriffAlerts\TriffAlertsService.cs" Link="TriffAlertsService.cs" />
    <Compile Include="..\..\native\TriffAlerts\CombatLogExport.cs" Link="CombatLogExport.cs" />
  </ItemGroup>

  <!-- Same arrangement again. CombatLogUpload is plain BCL (Net.Http, Text.Json,
       Uri parsing) with no WPF or Forms dependency, so it builds on net8.0 too. -->
  <ItemGroup>
    <Compile Include="..\..\native\TriffAlerts\CombatLogUpload.cs" Link="CombatLogUpload.cs" />
  </ItemGroup>

  <!-- TriffViewUpdateChecker.cs lives directly under native/, not native/TriffView/. It has no
       Windows-only dependencies (HttpClient, System.Text.Json, reflection), so it links the same way. -->
  <ItemGroup>
    <Compile Include="..\..\native\TriffViewUpdateChecker.cs" Link="TriffViewUpdateChecker.cs" />
  </ItemGroup>

  <!-- SplashFeatures.cs is pure BCL math (Math, Array, Span) with no Windows-only
       dependencies, so it links the same way as the groups above. -->
  <ItemGroup>
    <Compile Include="..\..\native\TriffAudio\SplashFeatures.cs" Link="SplashFeatures.cs" />
  </ItemGroup>

  <!-- SplashTemplate.cs is pure BCL (Buffers.Binary, Text.Json) with no Windows-only
       dependencies, so it links the same way as SplashFeatures.cs above. -->
  <ItemGroup>
    <Compile Include="..\..\native\TriffAudio\SplashTemplate.cs" Link="SplashTemplate.cs" />
  </ItemGroup>

  <!-- SplashDetector.cs is pure BCL (Math, Linq) with no Windows-only dependencies, so it
       links the same way as SplashFeatures.cs and SplashTemplate.cs above. -->
  <ItemGroup>
    <Compile Include="..\..\native\TriffAudio\SplashDetector.cs" Link="SplashDetector.cs" />
  </ItemGroup>

  <!-- Tests run from the build output directory, which has no path back to the source tree,
       so the 11 shipped splash templates are copied alongside the test binaries here; see
       TestTemplates.cs for the loader that resolves them from "templates/". -->
  <ItemGroup>
    <None Include="..\..\native\TriffAudio\Assets\splash-templates\**\*"
          Link="templates\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Accuracy fixtures for SplashAccuracyTests: committed .wav/.json pairs under
       fixtures/splash-accuracy, copied alongside the test binaries so the test can find them
       relative to AppContext.BaseDirectory. Separate from the "templates" group above. -->
  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
